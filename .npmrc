# Performance
prefer-offline=true
progress=true
fund=false
audit=true

# Security
strict-ssl=true

# Logs
loglevel=warn

# Registry
registry=https://registry.npmjs.org/

# Engine strict
engine-strict=false

# Save exact versions
save-exact=true
save-prefix=""

# Workspace
workspaces-update=true

# Peer dependencies
legacy-peer-deps=true
