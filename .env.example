# Kidareh environment template; copy to .env for local use.
# Never commit .env or real credentials.
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_APP=main:app
HOST=0.0.0.0
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
PORT=8000
THREADS=16
CONNECTION_LIMIT=200
CHANNEL_TIMEOUT=120
URL_SCHEME=https
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=1209600
WTF_CSRF_ENABLED=1
WTF_CSRF_TIME_LIMIT=3600
CSP_ENABLED=1
CSP_REPORT_ONLY=0
CSP_REPORT_URI=
HSTS_ENABLED=1
# SQLite data and uploads must be on a persistent mounted disk in production.
# On Liara, mount a disk at /app/data and set KIDAREH_DATA_DIR=/app/data.
KIDAREH_DATA_DIR=
DATABASE_PATH=
DB_PATH=
SQLALCHEMY_ECHO=0
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_RECYCLE=1800

# Shared cache (set REDIS_URL on production to share cache across Gunicorn workers).
# Leave empty for the bounded per-process in-memory cache.
REDIS_URL=
CACHE_PREFIX=kidareh:
CACHE_DEFAULT_TTL=300
CACHE_LOCAL_MAX_ITEMS=2048
UPLOAD_FOLDER=
# Vercel injects this secret automatically when the Blob store is connected.
# Leave empty for local development and Liara filesystem storage.
BLOB_READ_WRITE_TOKEN=
MAX_IMAGE_BYTES=4194304
MAX_CONTENT_LENGTH=4456448
PROXY_FIX_HOPS=0 # برای Liara با یک reverse proxy مقدار 1 قرار دهید
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
IMAGE_QUALITY=82
STATIC_MAX_AGE=604800
ASSET_VERSION=1
PWA_NAME=کیداره
PWA_SHORT_NAME=کیداره
PWA_THEME_COLOR=#ffffff
PWA_BACKGROUND_COLOR=#ffffff
DEFAULT_LOCALE=fa_IR
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_CURRENCY=IRR
MAIL_ENABLED=0
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
SMS_ENABLED=0
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER=
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
KAVENEGAR_VERIFY_TEMPLATE=
KAVENEGAR_TIMEOUT_SECONDS=15
KIDAREH_MIGRATION_LOCK_TIMEOUT=30
KIDAREH_SEED_DEMO_DATA=0
ADMIN_PHONE=
SHOW_OTP_IN_DEV=0
PAYMENT_ENABLED=0
PAYMENT_PROVIDER=
ZIBAL_MERCHANT=
ZIBAL_MERCHANT_ID=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=
RATELIMIT_ENABLED=1
RATELIMIT_DEFAULT=
RATELIMIT_LOGIN=
RATELIMIT_REGISTER=
RATELIMIT_STORAGE_URL=
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
FEATURE_NEARBY_SEARCH=0
FEATURE_SPECULATION_RULES=0
FEATURE_VIEW_TRANSITIONS=0
FEATURE_PWA_INSTALL=1
FEATURE_ONBOARDING=1
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
